<Window x:Class="WeatherApp_Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Weather App" Height="800" Width="400"
        WindowStyle="None"  
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="WeatherCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30" ClipToBounds="True">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#4A90E2" Offset="0.0" />
                    <GradientStop Color="#87CEEB" Offset="0.5" />
                    <GradientStop Color="#5DADE2" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="Both">
                <StackPanel Margin="0,0,0,30">
                    <StackPanel Margin="30,50,0,0">
                        <TextBlock Text="Cao Quán" FontSize="24" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="Nhiều mây" FontSize="16" Foreground="White" Opacity="0.8"/>
                    </StackPanel>

                    <TextBlock Text="27°" FontSize="120" 
                               Foreground="White" FontWeight="Light" 
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>

                    <UniformGrid Columns="2" Margin="10">
                        <Border Style="{StaticResource WeatherCardStyle}">
                            <Grid Height="150">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="UV" Foreground="White" Opacity="0.7" FontSize="14"/>
                                    <TextBlock Text="Yếu" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <Viewbox Grid.Row="1" Stretch="Uniform" VerticalAlignment="Center">
                                    <lvc:AngularGauge Value="{Binding CurrentWeather.UVIndex}" 
                                                      FromValue="0" ToValue="11" Wedge="180" 
                                                      TicksStep="1" LabelsStep="11" Foreground="White"/>
                                </Viewbox>
                                <TextBlock Grid.Row="1" Text="{Binding CurrentWeather.UVIndex}" Foreground="White" 
                                           FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource WeatherCardStyle}">
                            <StackPanel Height="150">
                                <TextBlock Text="Độ ẩm" Foreground="White" Opacity="0.7" FontSize="14"/>
                                <TextBlock Text="65%" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,20"/>
                                <ProgressBar Value="65" Height="5" Background="#22FFFFFF" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <Border Background="#33FFFFFF" CornerRadius="25" Margin="20,10,20,20" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Lịch sử dữ liệu (30 bản ghi gần nhất)" Foreground="White" 
                                       FontWeight="Bold" Margin="10,5,0,15"/>

                            <ItemsControl x:Name="ForecastList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#11FFFFFF" BorderThickness="0,0,0,1" Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DayName}" Foreground="White" Opacity="0.9"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TempMin, StringFormat={}{0}°C}" Foreground="#87CEEB" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TempMax, StringFormat={}{0}°C}" Foreground="Orange" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,15,20,0" Background="Transparent" BorderBrush="Transparent" 
                    Foreground="White" FontSize="18" Click="CloseApp_Click" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>