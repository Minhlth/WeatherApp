<Window x:Class="WeatherApp_Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Weather App" Height="800" Width="400"
        WindowStyle="None"  
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="WeatherCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="30" ClipToBounds="True">
       
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#4A90E2" Offset="0.0" />
                    <GradientStop Color="#87CEEB" Offset="0.5" />
                    <GradientStop Color="#5DADE2" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="30,50,0,0">
                <TextBlock Text="Cao Quán" FontSize="24" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="Nhiều mây" FontSize="16" Foreground="White" Opacity="0.8"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="27°" FontSize="120" 
                       Foreground="White" FontWeight="Light" 
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>
            <UniformGrid Grid.Row="2" Columns="2" Rows="2" Margin="10">

                <Border Style="{StaticResource WeatherCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock Text="UV" Foreground="White" Opacity="0.7" FontSize="12"/>
                            <TextBlock Text="Yếu" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>

                        <Viewbox Grid.Row="1" Stretch="Uniform" VerticalAlignment="Top">
                            <Grid Width="200" Height="120">
                                <lvc:AngularGauge Value="{Binding CurrentWeather.UVIndex}" 
                                  FromValue="0" ToValue="11"
                                  LabelsStep="11" TicksStep="1"
                                  Wedge="180" 
                                  TicksForeground="White"
                                  Foreground="White">
                                    <lvc:AngularGauge.Sections>
                                        <lvc:AngularSection FromValue="0" ToValue="3" Fill="#4CAF50"/>
                                        <lvc:AngularSection FromValue="3" ToValue="6" Fill="#FFEB3B"/>
                                        <lvc:AngularSection FromValue="6" ToValue="11" Fill="#F44336"/>
                                    </lvc:AngularGauge.Sections>
                                </lvc:AngularGauge>

                                <TextBlock Text="{Binding CurrentWeather.UVIndex}" 
                           Foreground="White" FontSize="40" FontWeight="Bold" 
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource WeatherCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Cảm giác như" Foreground="White" Opacity="0.7" FontSize="14"/>
                        <TextBlock Text="27°" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,15"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WeatherCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Gió" Foreground="White" Opacity="0.7" FontSize="14"/>
                        <TextBlock Text="22,6 km/h" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,15"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,15,20,0" Background="Transparent" BorderBrush="Transparent" 
                    Foreground="White" FontSize="18" Click="CloseApp_Click"/>
            <Border Grid.Row="3" Background="#33FFFFFF" CornerRadius="25" Margin="20,10,20,20" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Lịch sử dữ liệu (30 bản ghi gần nhất)" Foreground="White" 
                   FontWeight="Bold" Margin="10,5,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Height="250">
                        <ItemsControl x:Name="ForecastList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#11FFFFFF" BorderThickness="0,0,0,1" Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DayName}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TempMin, StringFormat={}{0}°C}" 
                                           Foreground="#87CEEB" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TempMax, StringFormat={}{0}°C}" 
                                           Foreground="Orange" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
    
</Window>